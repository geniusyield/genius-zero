# Genius Zero Preprod Integration Test Configuration
# Copy this file to .env.test or .env to configure your local test suite.

# Your Blockfrost Preprod Project API Key (Required for Preprod queries)
# Get a free key at https://blockfrost.io
BLOCKFROST_API_KEY_PREPROD=preprod...

# Optional: Dedicated Preprod test wallet 24-word mnemonic seed phrase.
# If omitted, test scripts can generate a fresh wallet for you to fund via the faucet.
# PREPROD_TEST_SEED="word1 word2 word3 ... word24"
